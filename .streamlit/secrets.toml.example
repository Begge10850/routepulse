# Copy this block into the Streamlit Community Cloud app's Secrets editor.
# Never rename this example to secrets.toml and commit real credentials.

[routepulse_snowflake]
account = "YOUR_ORGANIZATION-YOUR_ACCOUNT"
user = "ROUTEPULSE_PUBLIC_SERVICE"
role = "ROUTEPULSE_PUBLIC_READER"
warehouse = "ROUTEPULSE_PUBLIC_WH"
database = "ROUTEPULSE"
schema = "ANALYTICS"
# In Streamlit's Secrets editor, replace this with the complete unencrypted
# PKCS8 PEM value from .secrets/routepulse_rsa_key.p8, using triple quotes.
private_key = "PASTE_THE_UNENCRYPTED_PKCS8_PRIVATE_KEY_HERE"
